-- Aba Geral
-- =========================================================
local function buildGeneralTab()
    local tab = createTab("Geral", "house", PURPLE)

    local intro = tab:Section({ Title = "Apresentação", Box = true, BoxBorder = true, Opened = true })
    intro:Section({ Title = PRESENTATION, TextSize = 13, TextTransparency = 0.25 })
    intro:Space({ Columns = 1 })

    local copyBtn
    copyBtn = intro:Button({
        Title = "Copiar apresentação",
        Icon = "copy",
        Justify = "Center",
        Callback = function()
            pcall(function() copyBtn:Highlight() end)
            copyPresentation()
        end,
    })

    tab:Space({ Columns = 1 })

    local initializing = true
    tab:Dropdown({
        Title = "Qual categoria você está treinando?",
        Values = CATEGORIES,
        Value = nil,
        AllowNone = true,
        Callback = function(selected)
            if initializing then return end
            if type(selected) == "table" then selected = selected.Title end
            if type(selected) == "string" then openCategory(selected) end
        end,
    })
    initializing = false

    -- Créditos: bloco único e compacto, informações sempre visíveis
    tab:Space({ Columns = 1 })
    local creditsText = "Criador: " .. CREATOR .. "\nServidor: " .. SERVER
    local okCredits = pcall(function()
        tab:Paragraph({ Title = "Créditos", Desc = creditsText })
    end)
    if not okCredits then
        -- Fallback: Section simples (sem Box = sem expandir)
        tab:Section({ Title = "Créditos", TextSize = 12, Desc = creditsText })
    end
end

