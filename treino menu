local function P(title, lines)
    return {
        title = title,
        opened = false,
        lines = lines,
        icon = BLOCK_ICONS[string.match(title, "^(%S+)") or ""],
    }
end

local function minimo(texto)
    return { title = "Pontuação mínima para aprovação", desc = texto, opened = true, icon = "trophy" }
end

-- Parkours (versão A): dois por linha; nota opcional
local function parkours(a, b, c, d, nota)
    local lines = {
        "Parkour 1 — " .. a .. " s",
        "Parkour 2 — " .. b .. " s",
        "Parkour 3 — " .. c .. " s",
        "Parkour 4 — " .. d .. " s",
    }
    if nota then table.insert(lines, nota) end
    return P("Parkours — 1,0 ponto cada", lines)
end

local function torre(pc, cel)
    return P("Torre", { "PC e Console — " .. pc .. " s", "Celular — " .. cel .. " s" })
end

-- Texto gramatical padrão (0 / 1 / 2 pontos por faixa de erros)
local function texto(tempo, linhas, tema, limite)
    local faixa = (limite == 1) and "1 erro" or ("1 a " .. limite .. " erros")
    return P("Texto gramatical — 2,0 pontos", {
        "Tempo: " .. tempo .. ".",
        "Mínimo de " .. linhas .. " linhas.",
        "Tema: " .. tema .. ".",
        "Mais de " .. limite .. " erros: sem pontos.",
        faixa .. ": 1 ponto.",
        "Nenhum erro: 2 pontos.",
        "Fugiu do tema: sem pontos.",
        "Sempre apontar o erro gramatical.",
    })
end

local TEMA_EB = "Exército Brasileiro ou Exército Brasileiro do Delta"

-- exato = true → "20 comandos" (CPE); senão "No máximo N comandos"
local function comandos(n, exato)
    local abertura = exato
        and (n .. " comandos; qualquer erro = sem ponto.")
        or ("No máximo " .. n .. " comandos; qualquer erro = sem ponto.")
    return P("Comandos — 1,0 ponto", {
        abertura,
        "Direita / Esquerda / Retaguarda / Vanguarda volver!",
        "Pode haver comandos falsos para testar.",
        "Em call ou chat; o instrutor informa qual usará.",
        "Virar um pouco no falso, ou para o lado errado, é erro.",
    })
end

-- extras = true → inclui as regras de resposta múltipla / pergunta mal formulada
local function perguntas(qtd, timer, regra, extras)
    local lines = {
        qtd .. " sobre o EB do Delta ou o Exército Brasileiro.",
        regra,
        "Timer: " .. timer .. " segundos.",
        "Ao fim do timer, colocar as respostas na placa. Ninguém responde antes.",
    }
    if extras then
        table.insert(lines, "Mais de 1 resposta correta: todas são aceitas.")
        table.insert(lines, "Pergunta mal formulada deve ser refeita.")
    end
    return P("Perguntas — 1,0 ponto", lines)
end

