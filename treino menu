local BLOCK_ICONS = {
    ["Pontuação"] = "trophy", ["Polichinelos"] = "activity", ["Texto"] = "pen-line",
    ["Parkours"] = "mountain", ["Torre"] = "building-2", ["Perguntas"] = "message-circle",
