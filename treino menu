local function getWindowSize()
    local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
    return UDim2.fromOffset(math.clamp(vp.X - 40, 300, 480), math.clamp(vp.Y - 40, 220, 310))
end

-- Copiar (sem simular)
local function getClipboardFn()
    if type(setclipboard) == "function" then return setclipboard end
    if type(toclipboard) == "function" then return toclipboard end
    if type(Clipboard) == "table" and type(Clipboard.set) == "function" then return Clipboard.set end
    return nil
end

local function copyPresentation()
    local fn = getClipboardFn()
    if not fn then
        WindUI:Notify({
            Title = "Cópia indisponível",
            Content = "Seu executor não suporta área de transferência. Nada foi copiado.",
            Duration = 4,
        })
        return false
    end
    local ok = pcall(fn, PRESENTATION)
    WindUI:Notify({
        Title = ok and "Copiado!" or "Falha ao copiar",
        Content = ok and "Apresentação copiada." or "O executor retornou erro ao copiar.",
        Icon = ok and "check" or "x",
        Duration = 2,
    })
    return ok
end

