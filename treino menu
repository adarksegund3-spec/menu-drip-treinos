local function buildGeral()
    local p = newPage()
    local info = card(p, "INFORMAÇÕES")
    label(info, "Criador do script: " .. CREATOR, 11)
    label(info, "Servidor: " .. SERVER_URL, 11)
    button(info, "COPIAR SERVIDOR", function() copyText(SERVER_URL, "Servidor copiado") end)

    local cat = card(p, "CATEGORIA DO TREINAMENTO")
    label(cat, "Selecione a categoria do treinamento que você está conduzindo. Os tempos, quantidades e instruções serão utilizados automaticamente na aba Msg Pronta.", 10, false, C.dim)
    local head = button(cat, (Session.category or "Selecione a categoria") .. "  ▾", function() end,
        { Size = UDim2.new(1, 0, 0, 28) })
    local list = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Visible = false }, cat)
    new("UIListLayout", { Padding = UDim.new(0, 3) }, list)
    head.Activated:Connect(function() list.Visible = not list.Visible end)
    for _, name in ipairs(CATEGORIES) do
        button(list, name, function()
            head.Text = name .. "  ▾"
            list.Visible = false
            setCategory(name)
        end, { Size = UDim2.new(1, 0, 0, 24) })
    end

    local auto = card(p, "AUTO SE ORGANIZAR")
    label(auto, "Esta ferramenta auxilia na preparação do personagem para o treinamento, incluindo personagem de referência, posicionamento, clonagem e título de instrutor, conforme os comandos disponíveis no jogo.", 10, false, C.dim)
    local autoBtn
    local running = false
    local lastChat = 0
    local D = AUTO.delays

    local function getRoot()
        local ch = LocalPlayer.Character
        return ch and ch:FindFirstChild("HumanoidRootPart")
    end
    local function waitRoot(timeout)
        local t0 = os.clock()
        while os.clock() - t0 < (timeout or 5) do
            local r = getRoot()
            if r then return r end
            task.wait(0.1)
        end
    end
    local function chatStep(cmd)
        local gap = os.clock() - lastChat
        if gap < D.chatGap then task.wait(D.chatGap - gap) end
        local ok, err = sendChat(cmd)
        lastChat = os.clock()
        return ok, err
    end
    -- o jogo às vezes puxa o personagem de volta, por isso teleporta várias vezes
    local function goTo(pos)
        local ok = false
        for _ = 1, 5 do
            local r = waitRoot(5)
            if r then r.CFrame = CFrame.new(pos) ok = true end
            task.wait(0.1)
        end
        return ok
    end
    local function fail(msg)
        notify("error", "Auto Organizar interrompido", msg)
        running = false
        setEnabled(autoBtn, true)
    end

    local function runAuto()
        if running then return end
        running = true
        setEnabled(autoBtn, false)
        notify("info", "Auto Organizar", "Iniciando preparação do instrutor.")

        -- 1 char
        notify("info", "Passo 1/5", "Enviando comando de personagem.")
        local oldChar = LocalPlayer.Character
        local ok, err = chatStep(AUTO.char)
        if not ok then return fail("Falha ao enviar " .. AUTO.char .. ": " .. tostring(err)) end
        local t0 = os.clock()
        while LocalPlayer.Character == oldChar and os.clock() - t0 < D.charTimeout do task.wait(0.1) end
        if LocalPlayer.Character == oldChar then
            notify("warn", "Personagem", "Sem confirmação de troca de personagem; seguindo.")
        end
        waitRoot(5)
        task.wait(D.afterChar)

        -- 2 local do clone
        notify("info", "Passo 2/5", "Indo para a localização do clone.")
        if not goTo(AUTO.clonePos) then return fail("Personagem indisponível para ir à localização de clone.") end
        task.wait(D.afterTeleport)

        -- 3 clone
        notify("info", "Passo 3/5", "Enviando comando de clone.")
        ok, err = chatStep(AUTO.clone)
        if not ok then return fail("Falha ao enviar " .. AUTO.clone .. ": " .. tostring(err)) end
        task.wait(D.afterClone)

        -- 4 lado do botão
        notify("info", "Passo 4/5", "Indo para o lado do botão.")
        if not goTo(AUTO.destPos) then return fail("Personagem indisponível para ir à posição final.") end
        task.wait(D.afterDest)

        -- 5 titlebk
        notify("info", "Passo 5/5", "Enviando título de instrutor.")
        ok, err = chatStep(AUTO.title)
        if not ok then return fail("Falha ao enviar " .. AUTO.title .. ": " .. tostring(err)) end

        notify("success", "Auto Organizar", "Concluído: comandos enviados e posições aplicadas.")
        running = false
        setEnabled(autoBtn, true)
    end
    autoBtn = button(auto, "AUTO ORGANIZAR", function() task.spawn(runAuto) end, { Size = UDim2.new(1, 0, 0, 30) })
end


