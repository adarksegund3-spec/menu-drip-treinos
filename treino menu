local activeNotifs = {}

notify = function(kind, title, msg)
    local key = tostring(title) .. "|" .. tostring(msg)
    if activeNotifs[key] then return end
    activeNotifs[key] = true
    local accent = KIND_COLOR[kind] or C.baby

    local wrap = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y }, notifyHolder)
    local box = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.fromOffset(320, 0), BorderSizePixel = 0 }, wrap)
    corner(box, 10)
    new("UIGradient", { Rotation = 25, Color = ColorSequence.new(Color3.fromRGB(4, 4, 7), Color3.fromRGB(30, 20, 52)) }, box)
    local st = stroke(box, accent, 0.45, 1.5)
    new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, box)
    new("UIListLayout", { Padding = UDim.new(0, 3) }, box)
    new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = accent,
        TextXAlignment = Enum.TextXAlignment.Left, Text = string.upper(title), Size = UDim2.new(1, 0, 0, 16) }, box)
    new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = C.text,
        TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, Text = msg,
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, box)

    TweenService:Create(box, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Position = UDim2.fromOffset(0, 0) }):Play()
    TweenService:Create(st, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true),
        { Transparency = 0 }):Play()

    task.delay(NOTIFY_TIME, function()
        if not box.Parent then activeNotifs[key] = nil return end
        local t = TweenService:Create(box, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            { Position = UDim2.fromOffset(320, 0) })
        t:Play()
        t.Completed:Wait()
        wrap:Destroy()
        activeNotifs[key] = nil
    end)
end


