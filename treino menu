local Tabs = {}
local TabOrder = {}

local function createTab(title, icon, color)
    local tab = Window:Tab({
        Title = title,
        Icon = icon or "bookmark",
        IconColor = color or PURPLE,
        IconShape = "Square",
        Border = true,
    })
    Tabs[title] = tab
    table.insert(TabOrder, title)
    return tab
end

local function selectTab(title)
    local tab = Tabs[title]
    if not tab then return end
    local ok = pcall(function() tab:Select() end)
    if not ok then
        local index = table.find(TabOrder, title)
        if index then pcall(function() Window:SelectTab(index) end) end
    end
end

-- =========================================================
-- Renderização compacta (modelo de Praças = padrão de todas as abas)
-- =========================================================
local TITLE_SIZE = 13
local LINE_SIZE = 11
local LINE_TRANSPARENCY = 0.25
local BLOCK_GAP = false  -- true = espaço extra entre blocos
local TIGHTEN = true     -- reduz o vão entre o título e a informação (seguro: usa pcall)
local INNER_GAP = 2      -- espaço vertical interno (px) entre título e texto; 0 = colado
local ROOT_GAP = 4       -- espaço (px) entre a linha do título e o conteúdo do bloco
local DEBUG_UI = false   -- true = imprime no console a hierarquia encontrada

-- Cria a Section; se o Icon não for aceito pela versão da lib, tenta sem ele
local function newSection(parent, cfg)
    local ok, sec = pcall(function() return parent:Section(cfg) end)
    if ok and sec then return sec end
    cfg.Icon = nil
    return parent:Section(cfg)
end

-- Localiza o texto do bloco na interface já criada e reduz os espaçamentos
-- verticais SOMENTE dos containers entre o texto e o bloco (título preservado).
local UI_ROOT
local function scanRoots()
    if UI_ROOT and UI_ROOT.Parent then return { UI_ROOT } end
    local roots = {}
    pcall(function() if gethui then table.insert(roots, gethui()) end end)
    pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
    pcall(function()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pg then table.insert(roots, pg) end
    end)
    return roots
end

local function findLabel(text)
    for _, root in ipairs(scanRoots()) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text == text and not d:GetAttribute("DripTight") then
                if not UI_ROOT then UI_ROOT = d:FindFirstAncestorOfClass("ScreenGui") end
                return d
            end
        end
    end
end

local function hasText(frame, text)
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text == text then return true end
    end
    return false
end

local function tighten(title, text)
    if not TIGHTEN then return end
    task.spawn(function()
        task.wait(0.05)
        pcall(function()
            local label = findLabel(text)
            if not label then return end
            label:SetAttribute("DripTight", true)

            -- 1) mapeia a cadeia texto -> raiz do bloco (sem alterar nada ainda)
            local chain, node = {}, label.Parent
            while node and #chain < 8 and not hasText(node, title) do
                table.insert(chain, node)
                node = node.Parent
            end
            if not node or #chain >= 8 then
                if DEBUG_UI then warn("[Hub] raiz do bloco não encontrada: " .. title) end
                return
            end

            -- 2) só então aplica o ajuste
            for _, frame in ipairs(chain) do
                for _, c in ipairs(frame:GetChildren()) do
                    if c:IsA("UIPadding") then
                        c.PaddingTop = UDim.new(0, INNER_GAP)
                        c.PaddingBottom = UDim.new(0, INNER_GAP)
                    elseif c:IsA("UIListLayout") then
                        c.Padding = UDim.new(0, INNER_GAP)
                    end
                end
                if DEBUG_UI then print("[Hub]", title, frame.ClassName, frame.Name) end
            end
            local list = node:FindFirstChildOfClass("UIListLayout")
            if list then list.Padding = UDim.new(0, ROOT_GAP) end
        end)
    end)
end

local function renderBlock(parent, block)
    local box = newSection(parent, {
        Title = block.title,
        TextSize = TITLE_SIZE,
        Desc = block.desc,
        Icon = block.icon,
        Box = true,
        BoxBorder = true,
        Opened = block.opened ~= false,
    })
    -- Todas as linhas num único texto, uma por linha
    if block.lines and #block.lines > 0 then
        local bullets = {}
        for _, line in ipairs(block.lines) do
            table.insert(bullets, "• " .. line)
        end
        local joined = table.concat(bullets, "\n")
        box:Section({
            Title = joined,
            TextSize = LINE_SIZE,
            TextTransparency = LINE_TRANSPARENCY,
        })
        tighten(block.title, joined)
    end
end

local function buildCategory(name)
    local tab = createTab(name, CATEGORY_ICONS[name], CATEGORY_COLORS[name])
    local data = CONTENT[name]

    if not data then
        tab:Section({
            Title = name,
            TextSize = TITLE_SIZE,
            Desc = "Anotações desta categoria ainda não foram adicionadas.",
            Box = true,
            BoxBorder = true,
        })
        return
    end

    tab:Section({ Title = data.heading, TextSize = 16, FontWeight = Enum.FontWeight.SemiBold })
    tab:Space({ Columns = 1 })

    for _, item in ipairs(data.items) do
        renderBlock(tab, item)
        if BLOCK_GAP then tab:Space({ Columns = 1 }) end
    end
end

local function openCategory(name)
    if not Tabs[name] then
        buildCategory(name)
    end
    selectTab(name)
end

